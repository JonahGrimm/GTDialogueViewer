@using Blazor.Diagrams.Components.Renderers;
@using GTDialogueViewer.Nodes;

<div class="gtdialogue-node-card @(Node.NodeTitle.IsLocalizable ? "localizable-node" : "not-localizable-node")" 
     style="width: @(Node.GetNodeLength())px" 
     @onclick="SelectThisNode"
     @onclick:stopPropagation="true">
    <!-- Colored Top Banner Title -->
    <div class="node-header" style="background-color: rgba(@Node.AccentNodeColor.R, @Node.AccentNodeColor.G, @Node.AccentNodeColor.B, @((Node.AccentNodeColor.A/255)*(Node.NodeTitle.IsLocalizable ? 0.4 : 0.15)))">
        <p class="card-title @(Node.NodeTitle.IsLocalizable ? "localizable-text" : "not-localizable-text")">
            @Node.NodeTitle.GetText()
        </p>
    </div>
    

    <!-- Body Content Area -->
    <div class="node-body">
        <div class="ports-flex-row">
            <!-- Left Port Column -->
            <div class="port-col left">
                @foreach (var port in Node.Ports.Where(p => p.Alignment == PortAlignment.Left))
                {
                    <div class="port-wrapper">
                        <PortRenderer @key="port" Port="port" />
                    </div>
                }
            </div>

            <!-- Right Ports Stacked Column -->
            <div class="port-col right">
                @foreach (var (port, index) in Node.Ports.Where(p => p.Alignment == PortAlignment.Right).Select((p, i) => (Port: p, Index: i)))
                {
                    <div class="port-wrapper">
                        <span class="port-label @(Node.NodeTitle.IsLocalizable ? "localizable-text" : "not-localizable-text")">
                            @(index < Node.NodeOutputNames.Length ? Node.NodeOutputNames[index].GetText() : "Output")
                        </span>
                        <PortRenderer @key="port" Port="port" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public GTDialogueNodeModel Node { get; set; } = null!;
    
    [CascadingParameter] 
    public Action<GTDialogueNodeModel>? NotifyNodeSelected { get; set; }

    private void SelectThisNode()
    {
        NotifyNodeSelected?.Invoke(Node);
    }
}