@using GTDialogueViewer.Services
@inherits LayoutComponentBase
@inject EditorWorkspaceService Workspace
@inject IJSRuntime JS
@implements IDisposable

<div class="tab-container">
    <!-- Tab Headers Bar (Horizontal & Sortable) -->
    <SortableList class="tabs-container" OnReorder="HandleReorder">
        @foreach (var tab in Workspace.OpenTabs)
        {
            <div class="tab-item @(Workspace.ActiveTab == tab ? "active" : "")" 
                 @onclick="() => Workspace.SwitchTab(tab)">
                <span>@Path.GetFileName(tab.FilePath)</span>
                <button @onclick:stopPropagation="true" @onclick="() => Workspace.CloseTab(tab)">x</button>
            </div>
        }
    </SortableList>

    <!-- Tab Content Body -->
    <div class="tab-content border border-top-0 p-3 bg-white">
        @if (Workspace.ActiveTab != null)
        {
            <div class="mb-2 text-muted small">Path: @Workspace.ActiveTab.FilePath</div>
            <textarea class="form-control font-monospace" rows="15" @bind="Workspace.ActiveTab.Content" @bind:event="oninput"></textarea>
        }

        <div class="text-muted text-center py-5">
            <button class="btn btn-primary" @onclick="Workspace.OpenFilePrompt">Browse File...</button>
        </div>
    </div>
</div>

@code {

    // Static reference so Tauri's JS event trigger can hit this component instance
    private static EditorLayout? _instance;
    public EditorWorkspaceService WorkspaceService => Workspace;

    protected override void OnInitialized()
    {
        _instance = this;
        Workspace.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Listen for runtime events when the app is already open and another file is double-clicked
            await JS.InvokeVoidAsync("eval", @"
                window.__TAURI__.event.listen('open-file-from-os', (event) => {
                    DotNet.invokeMethodAsync('GTDialogueViewer', 'HandleExternalFiles', event.payload);
                });
            ");

            // 2. Check for initial command line arguments (cold launch by double-clicking a file)
            try
            {
                var argv = await JS.InvokeAsync<string[]>("window.__TAURI__.core.invoke", "get_startup_args");
                if (argv != null && argv.Length > 0)
                {
                    await Workspace.HandleExternalFilesInternal(argv.ToList());
                }
            }
            catch
            {
                // Fallback if command invoke isn't registered yet
            }
        }
    }

    private void HandleReorder((int oldIndex, int newIndex) indices)
    {
        Workspace.ReorderTabs(indices.oldIndex, indices.newIndex);
    }

    [JSInvokable]
    public static async Task HandleExternalFiles(List<string> args)
    {
        if (_instance?.Workspace != null)
        {
            await _instance.Workspace.HandleExternalFilesInternal(args);
        }
    }

    public void Dispose()
    {
        Workspace.OnChange -= StateHasChanged;
        if (_instance == this) _instance = null;
    }
}