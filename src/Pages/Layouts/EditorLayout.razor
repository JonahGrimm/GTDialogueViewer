@using GTDialogueViewer.Services
@inherits LayoutComponentBase
@inject EditorWorkspaceService Workspace
@inject IJSRuntime JS
@using System.IO
@implements IDisposable

<div class="tab-container">
    <!-- Tab Headers Bar (Horizontal & Sortable) -->
    <SortableList class="tabs-container" OnReorder="HandleReorder">
        @foreach (var tab in Workspace.OpenTabs)
        {
            <div class="tab-item @(Workspace.ActiveTab == tab ? "active" : "")" 
                 @onclick="() => Workspace.SwitchTab(tab)">
                <span>@tab.GetFileName()</span>
                <button @onclick:stopPropagation="true" @onclick="() => Workspace.CloseTab(tab)">x</button>
            </div>
        }
    </SortableList>

    <!-- Tab Content Body -->
    <div class="tab-content border border-top-0 p-3 bg-white">
        @if (Workspace.ActiveTab != null)
        {
            <textarea class="form-control font-monospace" rows="15" @bind="Workspace.ActiveTab.Content" @bind:event="oninput"></textarea>
        }

        <div class="text-muted text-center py-5">
            <button class="btn btn-primary" @onclick="Workspace.OpenFilePrompt">Browse File...</button>
        </div>
    </div>
</div>

<style>
    /* The tab bar container */
    .tabs-container {
        display: flex;
        background-color: #1e1e1e; /* Slightly darker than tabs for contrast */
        padding: 6px 6px 0 6px;
        overflow-x: auto;
        gap: 3px;
        border-bottom: 1px solid #111111;
        user-select: none;
        white-space: nowrap;
    }

    /* Hide scrollbar for clean look while keeping scrollability */
    .tabs-container::-webkit-scrollbar {
        height: 4px;
    }
    .tabs-container::-webkit-scrollbar-thumb {
        background: #3a3a3a;
        border-radius: 2px;
    }

    /* Individual tab item */
    .tab-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        background-color: #2d2d2d; /* Inactive tab color */
        color: #999999;
        font-size: 13px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        cursor: pointer;
        border: 1px solid #1f1f1f;
        border-bottom: none;
        max-width: 220px;
        min-width: 130px;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    /* Hover state for inactive tabs */
    .tab-item:hover {
        background-color: #333333;
        color: #dddddd;
    }

    /* Active tab state */
    .tab-item.active {
        background-color: #262626; /* Matches your specified background */
        color: #ffffff;
        border-color: #3a3a3a;
        border-bottom: 1px solid #262626; /* Merges seamlessly with content area */
        position: relative;
        z-index: 2;
    }

    /* Truncate long file paths nicely */
    .tab-item span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex-grow: 1;
    }

    /* Close button (x) */
    .tab-item button {
        background: transparent;
        border: none;
        color: #888888;
        cursor: pointer;
        font-size: 12px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.1s, color 0.1s;
    }

    /* Close button hover state */
    .tab-item button:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff;
    }
</style>

@code {

    // Static reference so Tauri's JS event trigger can hit this component instance
    private static EditorLayout? _instance;
    public EditorWorkspaceService WorkspaceService => Workspace;

    protected override void OnInitialized()
    {
        _instance = this;
        Workspace.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Listen for runtime events when the app is already open and another file is double-clicked
            await JS.InvokeVoidAsync("eval", @"
                window.__TAURI__.event.listen('open-file-from-os', (event) => {
                    DotNet.invokeMethodAsync('GTDialogueViewer', 'HandleExternalFiles', event.payload);
                });
            ");

            // 2. Check for initial command line arguments (cold launch by double-clicking a file)
            try
            {
                var argv = await JS.InvokeAsync<string[]>("window.__TAURI__.core.invoke", "get_startup_args");
                if (argv != null && argv.Length > 0)
                {
                    await Workspace.HandleExternalFilesInternal(argv.ToList());
                }
            }
            catch
            {
                // Fallback if command invoke isn't registered yet
            }
        }
    }

    private void HandleReorder((int oldIndex, int newIndex) indices)
    {
        Workspace.ReorderTabs(indices.oldIndex, indices.newIndex);
    }

    [JSInvokable]
    public static async Task HandleExternalFiles(List<string> args)
    {
        if (_instance?.Workspace != null)
        {
            await _instance.Workspace.HandleExternalFilesInternal(args);
        }
    }

    public void Dispose()
    {
        Workspace.OnChange -= StateHasChanged;
        if (_instance == this) _instance = null;
    }
}