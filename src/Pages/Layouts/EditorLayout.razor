@using GTDialogueViewer.Services
@inherits LayoutComponentBase
@inject EditorWorkspaceService Workspace
@inject IJSRuntime JS
@implements IDisposable

<div class="app-window">
    <!-- Custom Titlebar acting as the window drag zone -->
    <div class="custom-titlebar" data-tauri-drag-region>
        
        <!-- Left side: Tabs + Action Buttons wrapped together -->
        <div class="titlebar-left" data-tauri-drag-region>
            <!-- Sortable Tabs Area -->
            <SortableList class="tabs-container horizontal-scroll-zone" OnReorder="HandleReorder" data-tauri-drag-region>
                @foreach (var tab in Workspace.OpenTabs)
                {
                    <div class="tab-item @(Workspace.ActiveTab == tab ? "active" : "")" 
                         @onclick="() => Workspace.SwitchTab(tab)">
                        <span>@tab.GetFileName()</span>
                        <button @onclick:stopPropagation="true" @onclick="() => Workspace.CloseTab(tab)">×</button>
                    </div>
                }
            </SortableList>
            
        </div>

        <!-- Right side: Window Control Buttons (Minimize, Maximize, Close) -->
        <div class="window-controls">
            <button class="action-btn" @onclick="Workspace.OpenFilePrompt">📁 Open</button>
            <button class="win-btn minimize" @onclick="MinimizeWindow">&#x2013;</button>
            <button class="win-btn maximize" @onclick="MaximizeWindow">&#x25A2;</button>
            <button class="win-btn close" @onclick="CloseWindow">&#x2715;</button>
        </div>
    </div>
    
    <!-- Main Content Area -->
    <div class="content-area">
        @Body
        @if (Workspace.ActiveTab != null)
        {
            <textarea class="form-control font-monospace" rows="15" @bind="Workspace.ActiveTab.Content" @bind:event="oninput"></textarea>
        }
    </div>
</div>

<style>
    /* Layout container */
    .app-window {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #262626;
        overflow: hidden;
        user-select: none;
    }

    /* Custom Titlebar spanning the top */
    .custom-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #1e1e1e;
        height: 40px;
        border-bottom: 1px solid #111111;
        flex-shrink: 0;
        width: 100%;
    }

    /* Left side container holding tabs and buttons */
    .titlebar-left {
        display: flex;
        align-items: center;
        overflow: hidden;
        flex-grow: 1;
        min-width: 0;
        height: 100%;
    }

    .titlebar-left::-webkit-scrollbar {
        display: none;
    }

    /* Tabs container */
    .tabs-container {
        display: flex;
        align-items: flex-end;
        height: 100%;
        gap: 3px;
        padding-left: 6px;
        overflow-x: auto;      
        overflow-y: hidden;
        flex-grow: 1;
        min-width: 0;
        padding-right: 40px;
    }

    /* Hide scrollbars for Chrome, Safari, and Opera */
    .tabs-container::-webkit-scrollbar {
        display: none;
    }
    /* Hide scrollbars for IE, Edge, and Firefox */
    .tabs-container {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;     /* Firefox */
    }

    /* Individual browser-style tab */
    .tab-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 4px 0 12px;
        height: 26px;
        background-color: #292828;
        color: #999999;
        font-size: 12px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
        cursor: pointer;
        border: 1px solid #1f1f1f;
        border-bottom: none;
        max-width: 220px;
        min-width: 100px;
        flex-shrink: 0;
        transition: 0.1s ease;
    }

    .tab-item:hover {
        background-color: #333333;
        color: #dddddd;
        height: 32px;
    }

    .tab-item.active {
        background-color: #3b3b3b; /* Matches app background */
        color: #ffffff;
        border-color: #3a3a3a;
        position: relative;
        z-index: 2;
        height: 32px;
    }

    .tab-item span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex-grow: 1;
    }

    /* Close button inside tab */
    .tab-item button {
        background: transparent;
        border: none;
        color: #888888;
        cursor: pointer;
        font-size: 14px;
        width: 4px;
        height: 22px;
        padding-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: none;
    }

    .tab-item button:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }

    /* Extra action button (like Open File) inside titlebar */
    .action-btn {
        background-color: transparent;
        border: none;
        color: #cccccc;
        font-size: 12px;
        padding: 4px 10px;
        margin-left: 8px;
        border-radius: 4px;
        cursor: pointer;
        flex-shrink: 0;
        box-shadow: none;
        transition: background-color 0.1s;
    }

    .action-btn:hover {
        background-color: #333333;
        color: #ffffff;
    }

    /* Native-style Window Control Buttons (Right side) */
    .window-controls {
        display: flex;
        height: 100%;
        flex-shrink: 0;
        position: relative;
    }

    /* The gradient fade overlay */
    .window-controls::before {
        content: '';
        position: absolute;
        left: -35px; /* Width of the fade transition (adjust as desired) */
        top: 0;
        width: 35px;
        height: 100%;
        /* Fades from completely transparent to your titlebar/background color (#1e1e1e) */
        background: linear-gradient(to right, rgba(30, 30, 30, 0), #1e1e1e);
        pointer-events: none; /* Ensures you can still click things underneath if needed */
        z-index: 2;
    }

    .win-btn {
        background: transparent;
        border: none;
        color: #a0a0a0;
        width: 46px;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        box-shadow: none;
    }

    .win-btn:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }

    .win-btn.close:hover {
        background-color: #e81123; /* Windows close red */
        color: #ffffff;
    }

    /* Main content fills the rest of the height */
    .content-area {
        flex-grow: 1;
        overflow-y: auto;
        background-color: #262626;
        color: #ffffff;
    }
</style>

@code {
    private static EditorLayout? _instance;
    public EditorWorkspaceService WorkspaceService => Workspace;

    protected override void OnInitialized()
    {
        _instance = this;
        Workspace.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                window.__TAURI__.event.listen('open-file-from-os', (event) => {
                    DotNet.invokeMethodAsync('GTDialogueViewer', 'HandleExternalFiles', event.payload);
                });
            ");

            try
            {
                var argv = await JS.InvokeAsync<string[]>("window.__TAURI__.core.invoke", "get_startup_args");
                if (argv != null && argv.Length > 0)
                {
                    await Workspace.HandleExternalFilesInternal(argv.ToList());
                }
            }
            catch { }
        }
    }

    private void HandleReorder((int oldIndex, int newIndex) indices)
    {
        Workspace.ReorderTabs(indices.oldIndex, indices.newIndex);
    }

    // Window control invocations using Tauri's window API
    private async Task MinimizeWindow() => await JS.InvokeVoidAsync("window.appWindowControls.minimize");
    private async Task MaximizeWindow() => await JS.InvokeVoidAsync("window.appWindowControls.toggleMaximize");
    private async Task CloseWindow() => await JS.InvokeVoidAsync("window.appWindowControls.close");

    [JSInvokable]
    public static async Task HandleExternalFiles(List<string> args)
    {
        if (_instance?.Workspace != null)
        {
            await _instance.Workspace.HandleExternalFilesInternal(args);
        }
    }

    public void Dispose()
    {
        Workspace.OnChange -= StateHasChanged;
        if (_instance == this) _instance = null;
    }
}