@using Blazor.Diagrams.Components.Widgets
@using GTDialogueViewer.Nodes
@using GTDialogueViewer.Services

@if (ActiveTab != null)
{
    <!--<textarea class="form-control font-monospace" rows="15" @bind="ActiveTab.Content"></textarea>-->
    <div class="diagram-canvas-wrapper">
        <CascadingValue Value="OnNodeSelected" IsFixed="true">
            <CascadingValue Value="ActiveTab.Diagram" IsFixed="true">
                <DiagramCanvas>
                    <Widgets>
                        <GridWidget Size="30" Mode="GridMode.Line" BackgroundColor="#262626"/>
                    </Widgets>
                </DiagramCanvas>
            </CascadingValue>
        </CascadingValue>
    </div>
}

<style>
    /* Ensures a seamless, full-screen canvas workspace matching your layout background */
    .grid {
        background-color: #262626;
        background-image: linear-gradient(rgb(45, 45, 45) 1px, transparent 1px), linear-gradient(90deg, rgb(45, 45, 45) 1px, transparent 1px) !important;
    }
</style>

@code {
    [Parameter]
    public EditorTab? ActiveTab { get; set; }
    
    [Parameter]
    public EventCallback<GTDialogueNodeModel> OnNodeSelectedChanged { get; set; }

    private void OnNodeSelected(GTDialogueNodeModel node)
    {
        if (ActiveTab != null)
        {
            ActiveTab.SelectedNode = node; 
            StateHasChanged();
        }

        OnNodeSelectedChanged.InvokeAsync(node);
    }
}
