@using GTDialogueViewer.Services

@if (ActiveTab != null)
{
    <!--<textarea class="form-control font-monospace" rows="15" @bind="ActiveTab.Content"></textarea>-->
    <div class="diagram-canvas-wrapper">
        <CascadingValue Value="ActiveTab.Diagram" IsFixed="true">
            <DiagramCanvas></DiagramCanvas>
        </CascadingValue>
    </div>
}

<style>
    /* Ensures a seamless, full-screen canvas workspace matching your layout background */
    .diagram-canvas-wrapper{
        background-color: #262626; 
        background-image: radial-gradient(circle at 0 0, rgb(85, 85, 85) 1px, transparent 1px);
        background-size: 20px 20px;
    }
</style>

@code {
    [Parameter]
    public EditorTab? ActiveTab { get; set; }
}
