{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTDialogueViewer",
  "version": "0.1.0",
  "identifier": "com.GrimmTales.GTDialogueViewer",
  "build": {
    "beforeDevCommand": "dotnet watch run --project src/GTDialogueViewer.csproj",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "dotnet publish -c release src/GTDialogueViewer.csproj -o dist",
    "frontendDist": "../dist/wwwroot"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GTDialogueViewer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["gtdialogue"],
        "name": "Grimm Tales Dialogue System",
        "role": "Editor"
      }
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
